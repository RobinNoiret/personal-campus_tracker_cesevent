# Streamlabs Charity API Configuration
# Pour obtenir vos credentials :
# 1. Connectez-vous sur https://streamlabs.com
# 2. Allez dans Settings > API Settings
# 3. Enregistrez votre application pour obtenir Client ID et Client Secret
# 4. Utilisez le script pour obtenir un Access Token : npm run get-token

# Credentials OAuth (pour obtenir le token)
STREAMLABS_CLIENT_ID=your_client_id_here
STREAMLABS_CLIENT_SECRET=your_client_secret_here

# Access Token (généré via OAuth)
STREAMLABS_ACCESS_TOKEN=your_streamlabs_access_token_here

# PostgreSQL / Neon Database Configuration
# Pour obtenir votre connection string :
# 1. Connectez-vous sur https://console.neon.tech
# 2. Créez un nouveau projet ou sélectionnez un projet existant
# 3. Copiez la "Connection String" depuis le dashboard
# 4. La connection string ressemble à:
#    postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# Database URL (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
